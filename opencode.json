{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "ask",
      "backend/config/config.php": "deny",
      "backend/logs/**": "deny",
      ".env": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls*": "allow",
      "rm *": "deny",
      "del *": "deny",
      "Remove-Item*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git clean*": "deny"
    },
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "backend/config/config.php": "deny",
      "frontend/assets/vendor/**": "deny"
    }
  }
}